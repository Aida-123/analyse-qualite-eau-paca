   "source": [
    "comparaison = df.groupby([\"libminparametre\", \"plvconformitereferencechim\"])[\"valtraduite\"].mean().unstack()\n",
    "comparaison[\"ecart\"] = comparaison[\"N\"] - comparaison[\"C\"]\n",
    "comparaison_triee = comparaison.reindex(comparaison[\"ecart\"].abs().sort_values(ascending=False).index)\n",
    "comparaison_triee.head(15)"
   ]
  },
